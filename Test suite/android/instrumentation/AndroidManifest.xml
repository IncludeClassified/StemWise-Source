<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application>
        <provider
            android:name="app.stemwise.playback.PlaybackTestMediaProvider"
            android:authorities="${stemwisePlaybackTestMediaAuthority}"
            android:exported="true" />
    </application>
    <instrumentation
        android:targetProcesses="${stemwiseInstrumentationTargetProcesses}" />
    <instrumentation
        android:name="app.stemwise.integration.IsolatedUpdaterInstrumentationRunner"
        android:targetPackage="${stemwiseInstrumentationTargetPackage}"
        android:targetProcesses="${stemwiseInstrumentationTargetPackage}:updater_qualification" />
</manifest>
