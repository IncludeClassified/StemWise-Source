+	// StemWise: bounded equivalent of outputSeek(), sharing its pre-roll storage. The caller
+	// retains inputs and advances outputOffset only after a successful step.
+	template<class Inputs>
+	void outputSeekStep(Inputs &&inputs, int inputLength, int outputOffset, int outputCount) {
+		int latency = outputLatency();
+		int surplus = std::max(inputLength - inputLatency(), 0);
+		int seekSamples = inputLength - surplus;
+		if (outputOffset == 0) {
+			reset();
+			seek(inputs, seekSamples, surplus/Sample(latency));
+			tmpPreRollBuffer.resize(latency*channelCapacity);
+		}
+		int inputBegin = int(double(outputOffset)*surplus/latency);
+		int inputEnd = int(double(outputOffset + outputCount)*surplus/latency);
+		struct BufferOutput {
+			Sample *samples;
+			int length;
+			Sample *operator[](int c) { return samples + c*length; }
+		} preRollOutput{tmpPreRollBuffer.data() + outputOffset, latency};
+		OffsetIO<Inputs> offsetInput{inputs, seekSamples + inputBegin};
+		process(offsetInput, inputEnd - inputBegin, preRollOutput, outputCount);
+		if (outputOffset + outputCount == latency) {
+			for (auto &v : tmpPreRollBuffer) v = -v;
+			for (int c = 0; c < channels; ++c) {
+				auto *channel = tmpPreRollBuffer.data() + c*latency;
+				std::reverse(channel, channel + latency);
+				stft.addOutput(c, latency, channel);
+			}
+		}
+	}
 
